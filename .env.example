# ===========================================================================
# Echoes of History - configuration
#
# Copy to .env and fill in. Placeholder names only; never commit real values.
# Anything marked REQUIRED has no default and the system will say so by name
# if it is missing.
# ===========================================================================

# --- control surface -------------------------------------------------------
# DRY_RUN produces everything up to the upload and then stops. Leave it true
# until you have watched a finished file end to end.
DRY_RUN=true

# private | unlisted | public | scheduled
# 'scheduled' uploads private with a publishAt time; see PUBLISH_HOUR_LOCAL.
PUBLISH_MODE=private

MAX_CONCURRENT_JOBS=1
SCHEDULER_ENABLED=false
TZ=Asia/Baghdad
PUBLISH_HOUR_LOCAL=18
RETRY_MAX_ATTEMPTS=3

# --- duration --------------------------------------------------------------
TARGET_VIDEO_MINUTES=90
MIN_VIDEO_MINUTES=60
MAX_VIDEO_MINUTES=120
DURATION_TOLERANCE_MINUTES=8
# Words per minute used to size the script. The narration stage measures the
# real rate from the rendered audio; run `echoes calibrate` to fit
# PIPER_LENGTH_SCALE to this target for your chosen voice.
NARRATION_WPM=150

# --- database (REQUIRED) ---------------------------------------------------
# Everything durable lives here. A container filesystem does not survive a
# redeploy, so there is no SQLite fallback on purpose.
DATABASE_URL=postgresql://user:password@host:5432/echoes

# --- storage ---------------------------------------------------------------
DATA_DIR=/app/data
# local | s3   ('local' is durable ONLY if DATA_DIR is a mounted volume)
STORAGE_PROVIDER=local
# S3-compatible object storage. Cloudflare R2 is the cheapest usable option:
# 10 GB free and no egress charge.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- AI --------------------------------------------------------------------
# gemini | offline   ('offline' is a deterministic simulator for dry runs.
# Quality control refuses to pass an offline-written script when DRY_RUN is
# false, so it can never reach a real channel.)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.7

# --- narration -------------------------------------------------------------
# piper | silent   (piper is local, free, and has no rate limit)
TTS_PROVIDER=piper
PIPER_VOICE=en_GB-alan-medium
PIPER_VOICE_DIR=/app/voices
# Above 1 slows the voice. Fitted per voice by `echoes calibrate`; the stock
# rate is far too brisk for a documentary.
PIPER_LENGTH_SCALE=1.71
TTS_CHUNK_CHARS=1800

# --- research --------------------------------------------------------------
# Comma-separated. All keyless. 'fixtures' is offline only and is refused by
# quality control when DRY_RUN is false.
RESEARCH_PROVIDERS=wikipedia,loc,met,crossref
# Wikimedia and Crossref both ask bots to identify themselves; supplying an
# address is the difference between the polite pool and being throttled.
CONTACT_EMAIL=
MIN_SOURCES_PER_DOCUMENTARY=8
MAX_UNSUPPORTED_CLAIM_RATIO=0.05

# --- visuals ---------------------------------------------------------------
# wikimedia,met,loc are free and licence-checked. 'synthetic' generates
# placeholder plates for dry runs and is refused when DRY_RUN is false.
IMAGE_PROVIDERS=wikimedia,met,loc

# --- render ----------------------------------------------------------------
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=25
RENDER_PRESET=veryfast
RENDER_CRF=21
# Keep at or below half the available cores: x264 is already threaded, and
# more workers than this finish slower, not faster.
RENDER_SEGMENT_WORKERS=2
MUSIC_GAIN_DB=-26

# --- YouTube ---------------------------------------------------------------
# REQUIRED once DRY_RUN=false.
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=27
YOUTUBE_LANGUAGE=en

# --- editorial -------------------------------------------------------------
CHANNEL_NAME=Echoes of History
CHANNEL_HANDLE=@echoesofhistory-v
# Comma-separated. A proposed topic matching any of these is refused.
BANNED_TOPICS=
PREFERRED_ERAS=
# 0..1. A proposed title scoring at or above this against an existing one is
# rejected as a duplicate.
SIMILARITY_THRESHOLD=0.72

# --- notifications ---------------------------------------------------------
# noop | telegram
NOTIFY_PROVIDER=noop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API -------------------------------------------------------------------
PORT=8080
# REQUIRED for anything that starts, resumes or widens activity. With this
# unset those endpoints are refused, not left open. Pause and stop never
# require it, so the system can always be stopped.
API_TOKEN=

# --- docker compose only ---------------------------------------------------
POSTGRES_PASSWORD=
APP_PORT=8080
N8N_PORT=5678
